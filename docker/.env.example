# Copiar a `.env` (mismo directorio, ya en .gitignore) y completar con
# valores reales -- nunca commitear secretos reales a este repo.

# Ticket 025: requerido para que ClaudeProvider (default/activo) pueda
# llamar a la API real de Anthropic. Sin esta key, cualquier llamada real
# falla explícito (AiProviderException) -- para desarrollo/tests sin key,
# usar AI_VISION_PROVIDER=mock / AI_REASONING_PROVIDER=mock en vez de
# dejar esta vacía y confiar en que nadie llame a Claude.
ANTHROPIC_API_KEY=
